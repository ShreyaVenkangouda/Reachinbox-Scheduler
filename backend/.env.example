# ============================================================
# ReachInbox Email Scheduler - Backend .env.example
# Copy this file to .env and fill in REAL values
# NEVER commit .env with real credentials
# ============================================================

# --- Server ---
PORT=5000

# --- PostgreSQL (Docker exposes on 5434) ---
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5434/reachinbox?schema=public"

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://127.0.0.1:9200

# --- Worker Settings ---
WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=2000

# --- Rate Limiting ---
# Default: 200 emails per sender per hour window
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Rate-limit window in milliseconds (default: 1 hour = 3600000)
# For demo/testing you can set to 60000 (1 minute)
RATE_LIMIT_WINDOW_MS=3600000

# --- Ethereal SMTP (fake inbox for testing) ---
# Generate at https://ethereal.email/create
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-user@ethereal.email
SMTP_PASSWORD=your-ethereal-password
SMTP_FROM=Your Name <your-ethereal-user@ethereal.email>

# --- Google OAuth ---
# Create at https://console.cloud.google.com/apis/credentials
# Add http://localhost:5000/auth/google/callback as Authorized Redirect URI
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# --- Slack OAuth ---
# Create Slack App at https://api.slack.com/apps
# Required scopes: chat:write, chat:write.public, channels:read
# Add http://localhost:5000/api/integrations/slack/callback as Redirect URL
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:5000/api/integrations/slack/callback

# --- Frontend URL (for OAuth redirects) ---
FRONTEND_URL=http://localhost:5173

# --- JWT Session Secret ---
# Change to a long random string in production
SESSION_SECRET=change-me-to-a-long-random-secret
